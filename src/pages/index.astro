---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Welcome from '../components/Welcome.astro';
import Treatments from '../components/Treatments.astro';
import Afternoon from '../components/Afternoon.astro';
import Rituals from '../components/Rituals.astro';
import Gallery from '../components/Gallery.astro';
import Shelf from '../components/Shelf.astro';
import ClosingBand from '../components/ClosingBand.astro';
import FirstVisit from '../components/FirstVisit.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BookingBar from '../components/BookingBar.astro';

// §8's order, with the footage inserted after the treatments as the page's
// one cinematic pause (§13 amendment). When testimonials return they go back
// above the dark band: they do the persuading before the closer asks.
---

<Base
  title="Sunnyside Spa — a day spa in Utah"
  description="One room in the sun, booked one person at a time. Facials, brows, lashes and waxing in West Jordan, Utah."
>
  <SiteHeader />

  <main id="main" tabindex="-1">
    <Hero />
    <Welcome />
    <Treatments />
    <Afternoon />
    <Rituals />
    <Gallery />
    {/* Kind words (Testimonials.astro) is off until there are real client
        quotes: the drafts are invented, and on a live site they would read
        as genuine reviews. Add them in the component and put it back here. */}
    <Shelf />
    <ClosingBand />
    <FirstVisit />
  </main>

  <SiteFooter />
  <BookingBar />
</Base>
