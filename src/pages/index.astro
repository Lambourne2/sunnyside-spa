---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Welcome from '../components/Welcome.astro';
import Treatments from '../components/Treatments.astro';
import Afternoon from '../components/Afternoon.astro';
import Rituals from '../components/Rituals.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import Shelf from '../components/Shelf.astro';
import ClosingBand from '../components/ClosingBand.astro';
import FirstVisit from '../components/FirstVisit.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BookingBar from '../components/BookingBar.astro';

// §8's order, with the footage inserted after the treatments as the page's
// one cinematic pause (§13 amendment). Testimonials still sit above the dark
// band on purpose: they do the persuading before the closer asks.
---

<Base
  title="Sunnyside Spa — a day spa in Utah"
  description="One room in the sun, booked one person at a time. Massage, skincare, body and wellness treatments in Utah."
>
  <SiteHeader />

  <main id="main" tabindex="-1">
    <Hero />
    <Welcome />
    <Treatments />
    <Afternoon />
    <Rituals />
    <Gallery />
    <Testimonials />
    <Shelf />
    <ClosingBand />
    <FirstVisit />
  </main>

  <SiteFooter />
  <BookingBar />
</Base>
