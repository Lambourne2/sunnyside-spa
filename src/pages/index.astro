---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import HeroActions from '../components/HeroActions.astro';
import Welcome from '../components/Welcome.astro';
import Treatments from '../components/Treatments.astro';
import Rituals from '../components/Rituals.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import Shelf from '../components/Shelf.astro';
import ClosingBand from '../components/ClosingBand.astro';
import FirstVisit from '../components/FirstVisit.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BookingBar from '../components/BookingBar.astro';

// Section order is §8's, unchanged. Testimonials sit above the dark band on
// purpose: they do the persuading before the closer asks.
---

<Base title="Sunnyside Spa" description="A day spa in Utah. Book a treatment.">
  {/* §6 — the poster is the LCP element and is preloaded. The video is not. */}
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/brand/hero/poster.webp"
    type="image/webp"
    fetchpriority="high"
  />

  <SiteHeader />
  <Hero />

  <main id="main" tabindex="-1">
    {/* First thing under the full-screen hero, and the first thing the skip
        link lands on. */}
    <HeroActions />
    <Welcome />
    <Treatments />
    <Rituals />
    <Gallery />
    <Testimonials />
    <Shelf />
    <ClosingBand />
    <FirstVisit />
  </main>

  <SiteFooter />
  <BookingBar />
</Base>

