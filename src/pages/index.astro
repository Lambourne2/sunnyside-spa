---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';

// Phase 2 — the hero only. The remaining §8 sections (ribbon, nav, welcome,
// treatments, rituals, gallery, testimonials, shelf, dark band, first visit,
// footer) land in phase 3.
---

<Base title="Sunnyside Spa" description="A day spa in Utah. Book a treatment.">
  {/* §6 — the poster is the LCP element and is preloaded. The video is not. */}
  <link
    slot="head"
    rel="preload"
    as="image"
    href="/brand/hero/poster.webp"
    type="image/webp"
    fetchpriority="high"
  />

  <main>
    <Hero />
  </main>
</Base>
