---
import Page from '../layouts/Page.astro';
import Figure from '../components/Figure.astro';
import WaveDivider from '../components/WaveDivider.astro';
import BookCta from '../components/BookCta.astro';
import Icon from '../components/Icon.astro';
import { SITE, isPlaceholder } from '../config/site';

/** Visit — §8: where, parking, what to expect on arrival. No street address,
 *  phone or hours by request (2026-11-19), so no map either. */
type Step = { title: string; body: string; links?: { href: string; label: string }[] };
const ARRIVAL: Step[] = [
  // DRAFT COPY
  { title: 'Arrive at your appointment time', body: 'A couple of minutes early is perfectly fine with me.' },
  { title: 'The door', body: 'Come to the front door. If I am finishing with someone, give me a minute and I will be right with you.' },
  {
    title: 'How to prepare',
    body: 'Come without makeup if you can. Each treatment has a little pre and aftercare, so take a quick look before your visit:',
    links: [
      { href: '/treatments/waxing/#care', label: 'Waxing' },
      { href: '/treatments/lashes/#care', label: 'Lash lift' },
      { href: '/treatments/brows/#care', label: 'Brow lamination' },
    ],
  },
];
---

<Page
  title="Visit — Sunnyside Spa"
  description="Parking and what to expect when you arrive at Sunnyside Spa in West Jordan, Utah."
  eyebrow="Visit"
  heading="Finding the studio"
  lede="A home studio in West Jordan, by appointment only. Here is what happens when you walk in."
  mark="wellness"
>
  <section class="vs">
    <div class="shell vs__top">
      <div class="vs__facts reveal">
        <div class="vs__block">
          <h2 class="t-eyebrow">Where</h2>
          <address class="t-body vs__address">
            {SITE.city}, {SITE.state} {SITE.zip}
          </address>
          <p class="t-body vs__note">By appointment only. The full address is emailed to you as soon as you book.</p>
          {!isPlaceholder(SITE.email) && <p class="vs__links"><a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>}
        </div>

        <div class="vs__block">
          <h2 class="t-eyebrow">Parking</h2>
          {/* DRAFT COPY */}
          <p class="t-body">Park in the driveway. If it is full, there is street parking right outside.</p>
        </div>

        <BookCta />
      </div>
    </div>

    <div class="shell"><WaveDivider size="full" /></div>

    <div class="shell vs__arrival">
      <h2 class="t-h2">When you get here</h2>
      <ol class="vs__steps">
        {
          ARRIVAL.map((a) => (
            <li class="vs__step reveal">
              <h3 class="t-h3">{a.title}</h3>
              {/* DRAFT COPY */}
              <p class="t-body">{a.body}</p>
              {a.links && (
                <p class="vs__step-links">
                  {a.links.map((l) => <a class="link" href={l.href}>{l.label}</a>)}
                </p>
              )}
            </li>
          ))
        }
      </ol>
    </div>

    <div class="shell">
      <div class="vs__gallery reveal">
        <Figure
          shape="arch"
          ratio="4 / 5"
          src="/img/visit-tools.webp"
          alt="A hand raised against a pale sky holding the tools of the trade: lash tweezers, a fan brush and a wooden wax stick."
        />
      </div>
    </div>
  </section>
</Page>

<style>
  .vs { padding-block: var(--space-2xl); }

  .vs__top { display: grid; gap: var(--space-2xl); align-items: start; }

  .vs__facts { display: flex; flex-direction: column; gap: var(--space-xl); align-items: flex-start; }

  .vs__block { display: flex; flex-direction: column; gap: var(--space-xs); }

  .vs__address { font-style: normal; }

  .vs__links { line-height: 2; }

  .vs__hours { margin: 0; }

  .vs__hours-row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-block: var(--space-2xs);
    border-block-end: 1px solid var(--line-hair);
    max-width: 22rem;
  }

  .vs__hours-row dd { margin: 0; }

  .vs__note { color: var(--ink-soft); font-size: 0.9375rem; }

  .vs__map-plate {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    align-items: flex-start;
    justify-content: center;
    min-height: 22rem;
    padding: var(--space-xl);
    border-radius: var(--r-card);
    border: 1px solid var(--line-hair);
    background-color: var(--surface-tint);
    color: var(--rose-deep);
    --eyebrow-color: var(--rose-deep);
  }

  
  .vs__map-note { color: var(--ink-soft); max-width: 38ch; font-size: 0.9375rem; }

  .vs__arrival { padding-block: var(--space-2xl); }

  .vs__steps {
    display: grid;
    gap: var(--space-xl);
    margin-block-start: var(--space-xl);
  }

  .vs__step { display: flex; flex-direction: column; gap: var(--space-xs); }

  .vs__step-links { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-lg); }

  /* Held to a feature width — full bleed turned the arch into a dome that
     swallowed the page. Narrower again now the photo is portrait. */
  /* Nested inside .shell rather than sharing the element, so this sets its own
     width instead of out-specifying the utility. Left-aligned like the rest of
     the page — §13 rules out a centred-everything layout. */
  .vs__gallery { padding-block-end: var(--space-2xl); max-width: 26rem; }

  @media (min-width: 768px) {
    .vs__steps { grid-template-columns: repeat(2, 1fr); }
  }
</style>
