---
import BookCta from './BookCta.astro';

/**
 * The action bar directly under the hero.
 *
 * It sits OUTSIDE the masthead so the hero keeps the full viewport — the bar is
 * the first thing you meet on scrolling, rather than something overlaid on the
 * wall. That also means it needs no bespoke reveal logic: below the fold on
 * desktop, in view on mobile, and the standard .reveal handles both.
 *
 * Note on "See treatments": §8's layout draws it as a plain text link. Peyton
 * asked for two buttons in a bar, so it uses the §9 secondary button — 1px rose
 * border, transparent fill, chiffon on hover. Still a named component, not a
 * new style.
 *
 * Contrast on chiffon, all verified: rose-deep button edge 5.34:1, its shell
 * label 5.97:1, the secondary's ink label 13.28:1 and its rose border 3.19:1
 * (over the 3:1 that non-text UI needs).
 */
---

<div class="herobar grain">
  <div class="shell herobar__inner reveal">
    <BookCta />
    <a class="btn btn--secondary" href="/treatments/">See treatments</a>
  </div>
</div>

<style>
  .herobar {
    background-color: var(--lemon-chiffon);
    border-block-end: 1px solid var(--line-hair);
  }

  .herobar__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md);
    padding-block: clamp(var(--space-md), 2.4vw, var(--space-xl));
  }

  /* Under ~480px the two labels cannot share a row without dropping below §9's
     14px/28px padding, and left-aligned they wrapped to two ragged widths.
     Full width each is tidier and gives both a proper touch target. */
  @media (max-width: 479px) {
    .herobar__inner { flex-direction: column; align-items: stretch; }
  }
</style>
