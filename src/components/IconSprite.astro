---
/**
 * The five service icons — §5. Massage, Skincare, Body, Wellness, You Time.
 *
 * DRAWN, NOT TRACED. These exist in the supplied assets only as pixels inside
 * the 1536×1024 identity board (see docs/asset-audit/README.md §6), so they are
 * fresh monoline drawings in the §5 style, not traces. Authorised 2026-08-05.
 *
 * §2.2 / §5: one stroke weight for all line art — 1.5 at a 24px box, round caps,
 * no fills, no second colour, no shadows. Stroke is left to scale with the
 * viewBox on purpose, so the weight tracks the icon size and never thins out.
 *
 * Rendered once per page in the layout; Icon.astro references these by id.
 */
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  class="icon-sprite"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <g
      id="monoline-defaults"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    ></g>
  </defs>

  <!-- MASSAGE — sun over water -->
  <symbol id="icon-massage" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 14.6a5 5 0 0 1 10 0" />
      <path d="M12 3.2v2.4M6.1 6.1l1.7 1.7M17.9 6.1l-1.7 1.7M2.8 12h2.4M21.2 12h-2.4" />
      <path d="M2.5 17.9c1.9-1.5 3.8-1.5 5.7 0s3.8 1.5 5.7 0 3.8-1.5 5.6 0" />
      <path d="M2.5 21.3c1.9-1.5 3.8-1.5 5.7 0s3.8 1.5 5.7 0 3.8-1.5 5.6 0" />
    </g>
  </symbol>

  <!-- SKINCARE — botanical sprig -->
  <symbol id="icon-skincare" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 21.8V4.6" />
      <path d="M12 4.6Q10.3 2.9 12 1.4 13.7 2.9 12 4.6Z" />
      <path d="M12 9.2Q15 5.2 18.6 5.4 18 9.2 12 9.2Z" />
      <path d="M12 14Q9 10 5.4 10.2 6 14 12 14Z" />
      <path d="M12 18.6Q15 14.6 18.6 14.8 18 18.6 12 18.6Z" />
    </g>
  </symbol>

  <!-- BODY — lotus -->
  <symbol id="icon-body" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 18.4C10.5 15.5 10.3 11.9 12 8.2c1.7 3.7 1.5 7.3 0 10.2Z" />
      <path d="M13 18.5c.9-2.7 3.1-5.2 6-6.2.1 3.1-2.2 5.7-6 6.2Z" />
      <path d="M11 18.5c-.9-2.7-3.1-5.2-6-6.2-.1 3.1 2.2 5.7 6 6.2Z" />
      <path d="M4.5 21.6c1.6-1.2 3.2-1.2 4.8 0s3.2 1.2 4.8 0 3.2-1.2 4.7 0" />
    </g>
  </symbol>

  <!-- WELLNESS — wave and circle -->
  <symbol id="icon-wellness" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="8.4" r="4.6" />
      <path d="M2.5 17.2c1.9-1.5 3.8-1.5 5.7 0s3.8 1.5 5.7 0 3.8-1.5 5.6 0" />
      <path d="M2.5 21c1.9-1.5 3.8-1.5 5.7 0s3.8 1.5 5.7 0 3.8-1.5 5.6 0" />
    </g>
  </symbol>

  <!-- YOU TIME — full sun -->
  <symbol id="icon-you-time" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4.6" />
      <path d="M12 2.2v2.6M12 19.2v2.6M21.8 12h-2.6M4.8 12H2.2" />
      <path d="M18.9 5.1 17 7M7 17l-1.9 1.9M18.9 18.9 17 17M7 7 5.1 5.1" />
    </g>
  </symbol>

  <!-- Logomark rays, decomposed (§2.3) — used as the accordion marker -->
  <symbol id="icon-rays" viewBox="0 0 24 24">
    <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3.4v3.2M12 17.4v3.2M20.6 12h-3.2M6.6 12H3.4" />
      <path d="M18.1 5.9 15.8 8.2M8.2 15.8l-2.3 2.3M18.1 18.1l-2.3-2.3M8.2 8.2 5.9 5.9" />
    </g>
  </symbol>
</svg>

<style>
  .icon-sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
