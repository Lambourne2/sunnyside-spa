---
import Figure from './Figure.astro';
import Icon from './Icon.astro';

/**
 * Email list. Was §8's "shelf, soon" waitlist; on request (2026-11-19) it is
 * now a plain sign-up for news and openings, with the Rest. Recharge. Radiate.
 * card in place of the product shot. When a product launches it can become
 * the shelf again.
 *
 * The turning badge borrows the circular lockup from the identity board —
 * tracked caps set on a ring around the mark — and turns once a minute.
 */
---

<section class="shelf grain" aria-labelledby="shelf-title">
  <div class="shell shelf__grid">
    <div class="shelf__media reveal">
      <Figure
        class="shelf__figure"
        shape="hangtag"
        ratio="3 / 4"
        src="/img/rest-recharge-radiate.webp"
        alt="Rest. Recharge. Radiate. hand-lettered in white over sunlit water, with the Sunnyside sun-and-waves mark below."
      />
      <div class="shelf__badge" aria-hidden="true">
        <svg class="shelf__ring" viewBox="0 0 200 200">
          <defs><path id="shelf-ring" d="M100 100 m-78 0 a78 78 0 1 1 156 0 a78 78 0 1 1 -156 0" /></defs>
          <text><textPath href="#shelf-ring" textLength="486">Sunshine for your soul · stay in the loop ·</textPath></text>
        </svg>
        <Icon name="logomark" size={64} class="shelf__mark" />
      </div>
    </div>

    <div class="shelf__copy reveal">
      <p class="t-eyebrow"><span class="sec-num">05</span> &nbsp;Stay in touch</p>
      <h2 class="t-display shelf__title" id="shelf-title">Stay in the loop</h2>
      <p class="t-body">
        Join my email list for new services, openings and the occasional little
        extra. No spam, just a bit of sunshine in your inbox.
      </p>

      <form class="shelf__form" data-waitlist novalidate>
        <div class="field">
          <label class="field__label" for="shelf-email">Email</label>
          <input
            class="field__input"
            id="shelf-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            aria-describedby="shelf-email-error"
          />
          <!-- §11 verbatim error string, revealed by the validation script -->
          <p class="field__error" id="shelf-email-error" data-error hidden>
            That email is missing an @.
          </p>
        </div>

        <!-- §11 verbatim -->
        <button class="btn btn--primary" type="submit">Join the list</button>

        <!-- §11 verbatim confirmation -->
        <p class="t-body shelf__done" data-done hidden role="status">You're on the list.</p>
      </form>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const form = document.querySelector('[data-waitlist]');
    if (!form) return;
    const input = form.querySelector('input[type="email"]');
    const error = form.querySelector('[data-error]');
    const done = form.querySelector('[data-done]');

    const clear = () => {
      error.hidden = true;
      input.removeAttribute('aria-invalid');
    };

    input.addEventListener('input', clear);

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const value = input.value.trim();
      // §11 names one specific failure, so only that case gets that message.
      if (!value.includes('@')) {
        error.hidden = false;
        input.setAttribute('aria-invalid', 'true');
        input.focus();
        return;
      }
      clear();
      // No endpoint wired yet — this is list-building UI, not a live signup.
      form.querySelector('button[type="submit"]').disabled = true;
      done.hidden = false;
    });
  })();
</script>

<style>
  .shelf {
    padding-block: var(--section-y);
    background-color: var(--lemon-chiffon);
  }

  .shelf__title { max-width: 12ch; }

  .shelf__media { position: relative; width: min(100%, 24rem); }

  .shelf__badge {
    position: absolute;
    right: -2.5rem;
    top: 10%;
    width: 9.5rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background-color: var(--shell);
    border: 1px solid var(--line-hair);
    color: var(--rose-deep);
  }

  .shelf__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    fill: var(--rose-deep);
  }

  @media (prefers-reduced-motion: no-preference) {
    .shelf__ring { animation: ring-turn 60s linear infinite; }
  }

  @keyframes ring-turn { to { rotate: 360deg; } }

  .shelf__badge :global(.shelf__mark) { color: var(--dusty-rose); }

  @media (max-width: 767px) {
    .shelf__badge { right: -0.5rem; width: 8rem; }
  }

  .shelf__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .shelf__copy { display: flex; flex-direction: column; gap: var(--space-md); }

  .shelf__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    align-items: flex-start;
    max-width: 24rem;
    margin-block-start: var(--space-sm);
  }

  .shelf__form .field { width: 100%; }

  .shelf__done { color: var(--rose-deep); }

  @media (min-width: 768px) {
    .shelf__grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: clamp(var(--space-xl), 6vw, var(--space-3xl));
    }
  }
</style>
