---
import Figure from './Figure.astro';
import Icon from './Icon.astro';

// From the Mailchimp embed code (Audience → Signup forms → Embedded forms).
const MC_U = '11c127d11bb74a66b507beaa7';
const MC_ID = '3353cbe34f';
const MC_F = '0036b3e6f0';
const MC_POST = `https://app.us18.list-manage.com/subscribe/post?u=${MC_U}&id=${MC_ID}&f_id=${MC_F}`;
const MC_JSON = `https://app.us18.list-manage.com/subscribe/post-json?u=${MC_U}&id=${MC_ID}&f_id=${MC_F}`;
const MC_TRAP = `b_${MC_U}_${MC_ID}`;

/**
 * Email list. Was §8's "shelf, soon" waitlist; on request (2026-11-19) it is
 * now a plain sign-up for news and openings, with the Rest. Recharge. Radiate.
 * card in place of the product shot. When a product launches it can become
 * the shelf again.
 *
 * The turning badge borrows the circular lockup from the identity board —
 * tracked caps set on a ring around the mark — and turns once a minute.
 */
---

<section class="shelf grain" aria-labelledby="shelf-title">
  <div class="shell shelf__grid">
    <div class="shelf__media reveal">
      <Figure
        class="shelf__figure"
        shape="hangtag"
        ratio="3 / 4"
        src="/img/rest-recharge-radiate.webp"
        alt="Rest. Recharge. Radiate. hand-lettered in white over sunlit water, with the Sunnyside sun-and-waves mark below."
      />
      <div class="shelf__badge" aria-hidden="true">
        <svg class="shelf__ring" viewBox="0 0 200 200">
          <defs><path id="shelf-ring" d="M100 100 m-78 0 a78 78 0 1 1 156 0 a78 78 0 1 1 -156 0" /></defs>
          <text><textPath href="#shelf-ring" textLength="486">Sunshine for your soul · stay in the loop ·</textPath></text>
        </svg>
        <Icon name="logomark" size={64} class="shelf__mark" />
      </div>
    </div>

    <div class="shelf__copy reveal">
      <p class="t-eyebrow"><span class="sec-num">05</span> &nbsp;Stay in touch</p>
      <h2 class="t-display shelf__title" id="shelf-title">Stay in the loop</h2>
      <p class="t-body">
        Join my email list for new services, openings and the occasional little
        extra. No spam, just a bit of sunshine in your inbox.
      </p>

      {/* Posts to the Mailchimp audience from the embed code (2026-11-19).
          With JS it submits in the background and answers inline; without
          JS it falls back to Mailchimp's own page in a new tab. */}
      <form
        class="shelf__form"
        data-waitlist
        action={MC_POST}
        method="post"
        target="_blank"
        novalidate
      >
        <div class="field">
          <label class="field__label" for="shelf-fname">First name <span class="shelf__opt">(optional)</span></label>
          <input class="field__input" id="shelf-fname" name="FNAME" type="text" autocomplete="given-name" />
        </div>

        <div class="field">
          <label class="field__label" for="shelf-email">Email</label>
          <input
            class="field__input"
            id="shelf-email"
            name="EMAIL"
            type="email"
            autocomplete="email"
            required
            aria-describedby="shelf-email-error"
          />
          <p class="field__error" id="shelf-email-error" data-error hidden>
            That email is missing an @.
          </p>
        </div>

        {/* Mailchimp's bot trap: real people never see or fill this. */}
        <div class="shelf__trap" aria-hidden="true">
          <input type="text" name={MC_TRAP} tabindex="-1" value="" autocomplete="off" />
        </div>

        <button class="btn btn--primary" type="submit">Join the list</button>

        <p class="t-body shelf__done" data-done hidden role="status"></p>
      </form>
    </div>
  </div>
</section>

<script is:inline define:vars={{ MC_JSON }}>
  (() => {
    const form = document.querySelector('[data-waitlist]');
    if (!form) return;
    const input = form.querySelector('input[name="EMAIL"]');
    const fname = form.querySelector('input[name="FNAME"]');
    const trap = form.querySelector('.shelf__trap input');
    const error = form.querySelector('[data-error]');
    const done = form.querySelector('[data-done]');
    const button = form.querySelector('button[type="submit"]');

    const clear = () => {
      error.hidden = true;
      input.removeAttribute('aria-invalid');
    };
    const say = (text) => { done.textContent = text; done.hidden = false; };

    input.addEventListener('input', clear);

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const value = input.value.trim();
      if (!value.includes('@')) {
        error.hidden = false;
        input.setAttribute('aria-invalid', 'true');
        input.focus();
        return;
      }
      clear();
      button.disabled = true;
      done.hidden = true;

      // Mailchimp's JSONP endpoint: no CORS, so it answers via a callback.
      const cb = 'mcCb' + Date.now();
      const params = new URLSearchParams({ EMAIL: value, FNAME: fname.value.trim(), c: cb });
      params.set(trap.name, trap.value);
      const script = document.createElement('script');
      const cleanup = () => { delete window[cb]; script.remove(); };
      const timer = setTimeout(() => {
        cleanup();
        button.disabled = false;
        say('That did not go through. Please try again in a moment.');
      }, 10000);

      window[cb] = (res) => {
        clearTimeout(timer);
        cleanup();
        const msg = String((res && res.msg) || '').toLowerCase();
        if (res && res.result === 'success') {
          form.querySelectorAll('input').forEach((i) => { i.disabled = true; });
          say(msg.includes('confirm')
            ? 'Almost there. Check your inbox to confirm.'
            : "You're on the list.");
        } else if (msg.includes('already subscribed')) {
          say("You're already on the list.");
        } else {
          button.disabled = false;
          say('That did not go through. Check your email and try again.');
        }
      };
      script.src = MC_JSON + '&' + params.toString();
      script.onerror = () => {
        clearTimeout(timer);
        cleanup();
        button.disabled = false;
        say('That did not go through. Please try again in a moment.');
      };
      document.body.appendChild(script);
    });
  })();
</script>

<style>
  .shelf {
    padding-block: var(--section-y);
    background-color: var(--lemon-chiffon);
  }

  .shelf__title { max-width: 12ch; }

  .shelf__media { position: relative; width: min(100%, 24rem); }

  .shelf__badge {
    position: absolute;
    right: -2.5rem;
    top: 10%;
    width: 9.5rem;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background-color: var(--shell);
    border: 1px solid var(--line-hair);
    color: var(--rose-deep);
  }

  .shelf__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    fill: var(--rose-deep);
  }

  @media (prefers-reduced-motion: no-preference) {
    .shelf__ring { animation: ring-turn 60s linear infinite; }
  }

  @keyframes ring-turn { to { rotate: 360deg; } }

  .shelf__badge :global(.shelf__mark) { color: var(--dusty-rose); }

  @media (max-width: 767px) {
    .shelf__badge { right: -0.5rem; width: 8rem; }
  }

  .shelf__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  .shelf__copy { display: flex; flex-direction: column; gap: var(--space-md); }

  .shelf__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    align-items: flex-start;
    max-width: 24rem;
    margin-block-start: var(--space-sm);
  }

  .shelf__form .field { width: 100%; }

  .shelf__done { color: var(--rose-deep); }

  .shelf__opt { text-transform: none; letter-spacing: 0.04em; color: var(--ink-soft); }

  .shelf__trap { position: absolute; left: -5000px; }

  @media (min-width: 768px) {
    .shelf__grid {
      grid-template-columns: 0.8fr 1.2fr;
      gap: clamp(var(--space-xl), 6vw, var(--space-3xl));
    }
  }
</style>
