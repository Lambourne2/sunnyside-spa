---
import Icon from './Icon.astro';

/**
 * §8 — YOUR FIRST VISIT. Accordion on hairline rose rules, no boxes, no
 * containers (§9). The marker is the logomark's rays, rotating 45° on open.
 *
 * Native <details>/<summary>, so it works with no JS and is keyboard- and
 * screen-reader-correct by default.
 *
 * All answers are DRAFT except where they only contain placeholders.
 */
const ITEMS = [
  {
    q: 'When should I arrive?',
    // DRAFT COPY
    a: 'Fifteen minutes before your first appointment. That gives you time to fill in a short intake form and sit down with a glass of water before we start.',
  },
  {
    q: 'What do I wear?',
    // DRAFT COPY
    a: 'Whatever you are comfortable in. For a facial you lie back under a blanket. For arm or leg waxing, loose clothes over the area make the drive home nicer. For lashes, come without eye makeup if you can.',
  },
  {
    q: 'What if I need to cancel?',
    // DRAFT COPY
    a: 'Let me know at least 24 hours ahead and there is no charge. Inside that window I ask for [CANCELLATION FEE]. Things come up — call and we will work it out.',
  },
  {
    q: 'Where do I park?',
    // DRAFT COPY
    a: 'Park in the driveway. If it is full, there is street parking right outside. Come to the front door.',
  },
];
---

<section class="visit" aria-labelledby="visit-title">
  <div class="shell visit__grid">
    <header class="sec-head visit__head">
      <p class="t-eyebrow reveal"><span class="sec-num">07</span> &nbsp;Your first visit</p>
      <h2 class="t-display sec-head__title" id="visit-title" data-split>What to expect</h2>
    </header>

    <div class="accordion visit__list">
      {
        ITEMS.map((item) => (
          <details class="accordion__item visit__item">
            <summary class="accordion__trigger visit__trigger">
              <span>{item.q}</span>
              <Icon name="rays" size={22} class="visit__marker" />
            </summary>
            {/* DRAFT COPY */}
            <div class="accordion__panel">
              <p class="t-body">{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .visit { padding-block: var(--section-y); }

  .visit__grid { display: grid; gap: var(--space-lg); align-items: start; }

  @media (min-width: 900px) {
    .visit__grid { grid-template-columns: 0.8fr 1.2fr; gap: clamp(var(--space-2xl), 6vw, var(--space-4xl)); }
    .visit__head { position: sticky; top: calc(var(--nav-h) + var(--space-2xl)); }
  }

  .visit__list { border-block-start: 1px solid var(--line-hair); }

  .visit__trigger { padding-block: var(--space-lg); }

  /* Open and close smoothly where the browser can animate to auto height.
     Elsewhere the panel simply appears — native <details> either way. */
  @media (prefers-reduced-motion: no-preference) {
    .visit__item { interpolate-size: allow-keywords; }
    .visit__item::details-content {
      block-size: 0;
      overflow: clip;
      transition: block-size 600ms var(--ease-glide), content-visibility 600ms allow-discrete;
    }
    .visit__item[open]::details-content { block-size: auto; }
  }

  .visit__item .accordion__panel { padding-block-end: var(--space-lg); }

  /* Hairline rose rules, no containers (§9). */
  .visit__item { border-block-end: 1px solid var(--line-hair); }

  .visit__trigger {
    list-style: none;
    cursor: pointer;
  }

  /* Remove the native disclosure triangle so the rays are the only marker. */
  .visit__trigger::-webkit-details-marker { display: none; }

  .visit__marker { color: var(--dusty-rose); }

  /* §9 — the marker is the logomark's rays rotating 45° on open. */
  @media (prefers-reduced-motion: no-preference) {
    .visit__marker { transition: rotate var(--dur-nav) var(--ease-reveal); }
  }

  .visit__item[open] .visit__marker { rotate: 45deg; }
</style>
