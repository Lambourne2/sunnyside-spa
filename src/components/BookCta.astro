---
import { BOOKING } from '../config/site';

/**
 * The single conversion action, in one component so the Square handoff is
 * described in exactly one place.
 *
 * Until BOOKING.configured is true this points at /booking/, which explains
 * what is coming. Once the Square URL is in, it goes straight there.
 *
 * Square's booking site is a different origin, so it opens in a new tab and
 * says so — sending someone off-site mid-flow without warning is how you lose
 * them. `rel="noopener"` because the destination gets a window handle otherwise.
 */
interface Props {
  label?: string;
  /** `secondary` where a filled pill would be the second on screen; `on-dark` on the deep-sea band. */
  variant?: 'primary' | 'secondary' | 'on-dark';
  size?: 'md' | 'lg';
  /** Drifts toward the pointer (fine pointers, motion allowed only). */
  magnetic?: boolean;
  /** Preselects this treatment on /booking/ while Square isn't connected. */
  treatment?: string;
  /** A specific service's Square id: books straight into that service. */
  squareId?: string;
  class?: string;
}
const {
  label = 'Book a visit',
  variant = 'primary',
  size = 'md',
  magnetic = false,
  treatment,
  squareId,
  class: className = '',
} = Astro.props;

const live = BOOKING.configured && !BOOKING.url.startsWith('[');
const href = live
  ? squareId ? `${BOOKING.url}/${squareId}` : BOOKING.url
  : treatment ? `/booking/?t=${treatment}` : '/booking/';
---

<a
  class:list={['btn', `btn--${variant}`, size === 'lg' && 'btn--lg', className]}
  data-magnetic={magnetic ? '' : undefined}
  href={href}
  target={live ? '_blank' : undefined}
  rel={live ? 'noopener' : undefined}
>
  {label}
  <svg class="btn__rays" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href="#icon-rays" /></svg>
  {live && <span class="visually-hidden">(opens Square booking in a new tab)</span>}
</a>
