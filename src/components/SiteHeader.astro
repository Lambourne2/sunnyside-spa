---
import Logo from './Logo.astro';
import BookCta from './BookCta.astro';
import { SITE } from '../config/site';

/**
 * Nav — a floating liquid-glass pill (§13 amendment: glass is for floating
 * chrome). Over the hero it is mostly clear; once the hero clears it firms up.
 * While you read downward it tucks away, and it comes back the moment you
 * scroll up. site.ts drives all three states.
 *
 * Under 900px the links fold into a menu sheet — a native <dialog>, so focus
 * is trapped and Esc closes it without any code of ours. Booking never folds:
 * the dock at the bottom of the screen carries it on phones.
 */
interface Props {
  /** Interior pages have no hero to sit over. */
  solid?: boolean;
}
const { solid = false } = Astro.props;

const NAV = [
  { href: '/treatments/', label: 'Treatments' },
  { href: '/my-story/', label: 'My story' },
  { href: '/visit/', label: 'Visit' },
];
const path = Astro.url.pathname;
const current = (href: string) => path.startsWith(href);
---

<header class:list={['nav', solid && 'is-solid']} data-nav data-nav-solid={solid ? '' : undefined}>
  <div class="nav__bar glass" data-liquid="22">
    <a class="nav__home" href="/">
      <Logo variant="horizontal" width={124} label="Sunnyside Spa, home" />
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul class="nav__list" role="list">
        {NAV.map((item) => (
          <li>
            <a
              class="nav__link t-eyebrow"
              href={item.href}
              aria-current={current(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav__end">
      <BookCta label="Book" class="nav__book" magnetic />
      <button
        class="nav__menu"
        type="button"
        data-menu-open
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span class="t-eyebrow">Menu</span>
        <span class="nav__burger" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
</header>

<dialog class="menu" id="site-menu" data-menu aria-label="Site menu">
  <div class="menu__sheet glass" data-liquid="36">
    <div class="menu__top">
      <Logo variant="horizontal" width={120} />
      <button class="menu__close" type="button" data-menu-close>
        <span class="t-eyebrow">Close</span>
      </button>
    </div>

    <nav aria-label="Menu">
      <ol class="menu__list" role="list">
        <li><a class="menu__link" href="/"><span class="sec-num">00</span><span>Home</span></a></li>
        {NAV.map((item, i) => (
          <li>
            <a class="menu__link" href={item.href} aria-current={current(item.href) ? 'page' : undefined}>
              <span class="sec-num">{String(i + 1).padStart(2, '0')}</span>
              <span>{item.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="menu__foot">
      <BookCta size="lg" />
      <p class="t-meta">Appointments only · {SITE.neighbourhood}, UT</p>
    </div>
  </div>
</dialog>

<style>
  .nav {
    position: fixed;
    inset-inline: 0;
    top: max(12px, env(safe-area-inset-top));
    z-index: 70;
    display: flex;
    justify-content: center;
    padding-inline: var(--gutter);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav { transition: translate 600ms var(--ease-glide); }
  }

  .nav.is-tucked { translate: 0 calc(-100% - 64px); }

  .nav__bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: var(--space-md);
    width: min(100%, 68rem);
    min-height: 3.5rem;
    padding: 6px 6px 6px 22px;
    border-radius: var(--r-tag);
    transition: background-color var(--dur-nav) var(--ease-reveal),
                box-shadow var(--dur-nav) var(--ease-reveal);
  }

  /* Over the wall the pane is nearly clear — the refraction is the point.
     Once it is over content it firms up so the links stay legible over
     photography and copy alike. */
  .nav.is-condensed .nav__bar,
  .nav.is-solid .nav__bar { background-color: var(--glass-tint-hi); }

  .nav__home {
    display: block;
    flex: none;
    color: var(--ink);
    border-radius: 2px;
  }

  .nav__links { flex: 1; display: flex; justify-content: center; }

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-md), 3vw, var(--space-xl));
  }

  .nav__link {
    position: relative;
    display: inline-block;
    padding: 10px 2px;
    color: var(--ink);
    text-decoration: none;
    --eyebrow-color: var(--ink);
  }

  /* The underline grows from the centre; a small sun dot marks this page. */
  .nav__link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 4px;
    height: 1px;
    background-color: var(--dusty-rose);
    scale: 0 1;
    transition: scale var(--dur-nav) var(--ease-reveal);
  }

  .nav__link:hover::after,
  .nav__link:focus-visible::after,
  .nav__link[aria-current='page']::after { scale: 1 1; }

  .nav__end { display: flex; align-items: center; gap: var(--space-xs); margin-inline-start: auto; }

  .nav__end :global(.btn) { padding: 13px 22px; }

  .nav__menu {
    display: none;
    align-items: center;
    gap: var(--space-sm);
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--line-hair);
    border-radius: var(--r-tag);
    background-color: rgb(252 248 239 / 0.5);
    color: var(--ink);
    cursor: pointer;
    --eyebrow-color: var(--ink);
  }

  .nav__burger { display: grid; gap: 5px; width: 18px; }
  .nav__burger i { display: block; height: 1.5px; border-radius: 2px; background: currentColor; }
  .nav__burger i:last-child { width: 70%; justify-self: end; }

  @media (max-width: 899px) {
    .nav__links { display: none; }
    .nav__menu { display: inline-flex; }
    .nav__bar { padding-inline-start: 18px; }
  }

  /* On phones the dock carries booking, so the bar is logo + menu only. */
  @media (max-width: 639px) {
    .nav__end :global(.nav__book) { display: none; }
  }

  /* ── Menu sheet ───────────────────────────────────────────────────────── */

  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: max(12px, env(safe-area-inset-top)) var(--gutter) max(12px, env(safe-area-inset-bottom));
    border: 0;
    background: transparent;
    color: var(--ink);
  }

  .menu::backdrop {
    background: rgb(42 33 28 / 0.18);
    -webkit-backdrop-filter: blur(6px);
            backdrop-filter: blur(6px);
  }

  .menu__sheet {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    min-height: 100%;
    padding: var(--space-lg);
    border-radius: 28px;
    background-color: rgb(252 248 239 / 0.9);
  }

  .menu__top { display: flex; align-items: center; justify-content: space-between; }

  .menu__close {
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--line-hair);
    border-radius: var(--r-tag);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    --eyebrow-color: var(--ink);
  }

  .menu__list { display: grid; gap: var(--space-2xs); margin-block-start: var(--space-lg); }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-block-end: 1px solid var(--line-hair);
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2rem, 9vw, 3rem);
    letter-spacing: var(--ls-h2);
    text-transform: uppercase;
    line-height: 1.1;
  }

  .menu__link[aria-current='page'] { color: var(--rose-deep); }

  .menu__foot { margin-block-start: auto; display: grid; gap: var(--space-md); justify-items: start; }

  @media (prefers-reduced-motion: no-preference) {
    .menu[open] .menu__sheet { animation: sheet-in 620ms var(--ease-glide) both; }
    .menu[open] .menu__link { animation: link-in 700ms var(--ease-glide) both; }
    .menu[open] li:nth-child(2) .menu__link { animation-delay: 60ms; }
    .menu[open] li:nth-child(3) .menu__link { animation-delay: 120ms; }
    .menu[open] li:nth-child(4) .menu__link { animation-delay: 180ms; }
    .menu.is-closing .menu__sheet { animation: sheet-out 420ms var(--ease-reveal) both; }
  }

  @keyframes sheet-in  { from { opacity: 0; translate: 0 -16px; scale: 0.97; } }
  @keyframes sheet-out { to   { opacity: 0; translate: 0 -12px; scale: 0.98; } }
  @keyframes link-in   { from { opacity: 0; translate: 0 18px; } }
</style>
