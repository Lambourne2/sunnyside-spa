---
import BookCta from './BookCta.astro';
import { LOGOMARK } from '../data/marks';

/**
 * §8 — THE CLOSER. The page's only dark moment and the only place royal gold
 * appears. It carries booking, not membership: when memberships launch they
 * take this band back and booking returns to a lighter band above the FAQ.
 *
 * The logomark is drawn on as you scroll into the band (§10's draw-on, which
 * needed real paths — marks.ts has them now) and the sun sinks into its waves
 * as you scroll past: the afternoon §10 started at the top of the page ends
 * here. Under reduced motion it is simply drawn.
 *
 * All copy verbatim §11.
 */
const sun = LOGOMARK.paths.filter((p) => p.role !== 'wave');
const waves = LOGOMARK.paths.filter((p) => p.role === 'wave');
---

<section class="closer band-dark grain" aria-labelledby="closer-title">
  <div class="shell closer__inner">
    <svg
      class="closer__mark"
      data-closer-mark
      viewBox={`0 0 ${LOGOMARK.box[0]} ${LOGOMARK.box[1]}`}
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <clipPath id="closer-sea">
          <rect x="-10" y="-10" width="90" height="53" />
        </clipPath>
      </defs>
      <g class="closer__sun" clip-path="url(#closer-sea)">
        <g class="closer__sun-inner">
          {sun.map((p, i) => (
            <path d={p.d} style={`--d:${i}`} />
          ))}
        </g>
      </g>
      {waves.map((p, i) => (
        <path class="closer__wave" d={p.d} style={`--d:${i + sun.length}`} />
      ))}
    </svg>

    <p class="t-eyebrow">No membership needed</p>
    <!-- §11 verbatim -->
    <h2 class="t-quote closer__quote" id="closer-title">An hour that is only yours</h2>
    <!-- §11 verbatim -->
    <BookCta variant="on-dark" size="lg" magnetic />
  </div>
</section>

<script>
  const mark = document.querySelector<SVGSVGElement>('[data-closer-mark]');
  if (mark && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    mark.querySelectorAll<SVGPathElement>('path').forEach((p) => {
      p.style.setProperty('--len', `${Math.ceil(p.getTotalLength()) + 1}px`);
    });
    mark.classList.add('is-armed');
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        mark.classList.add('is-drawn');
        io.disconnect();
      }
    }, { threshold: 0.35 });
    io.observe(mark);
  }
</script>

<style>
  .closer {
    padding-block: var(--section-y);
    overflow: hidden;
  }

  .closer__inner {
    display: grid;
    justify-items: start;
    gap: var(--space-lg);
  }

  .closer__quote {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(3rem, 9vw, 7.5rem);
    line-height: 0.95;
    rotate: -2deg;
  }

  .closer__mark {
    width: min(70vw, 26rem);
    overflow: visible;
    fill: none;
    stroke: var(--royal-gold);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Drawn on once as the band arrives (§10's draw-on: sun first, then waves,
     40ms apart), then left still. It used to be scrubbed by scroll position,
     redrawing on every scroll frame, which flickered on phones (2026-11-19).
     Dash lengths are measured in px by the script below rather than relying
     on pathLength, which Safari handles unevenly. */
  @media (prefers-reduced-motion: no-preference) {
    .closer__mark.is-armed path {
      stroke-dasharray: var(--len);
      stroke-dashoffset: var(--len);
      transition: stroke-dashoffset 900ms var(--ease-reveal) calc(var(--d) * 40ms);
    }
    .closer__mark.is-drawn path { stroke-dashoffset: 0; }
  }

  @media (min-width: 900px) {
    .closer__inner {
      grid-template-columns: 1fr auto;
      align-items: end;
      column-gap: var(--space-2xl);
    }
    .closer__mark {
      grid-column: 2;
      grid-row: 1 / span 3;
      align-self: center;
      width: min(36vw, 30rem);
    }
  }
</style>
