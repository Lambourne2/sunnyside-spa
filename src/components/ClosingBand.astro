---
import BookCta from './BookCta.astro';
import { LOGOMARK } from '../data/marks';

/**
 * §8 — THE CLOSER. The page's only dark moment and the only place royal gold
 * appears. It carries booking, not membership: when memberships launch they
 * take this band back and booking returns to a lighter band above the FAQ.
 *
 * The logomark is drawn on as you scroll into the band (§10's draw-on, which
 * needed real paths — marks.ts has them now) and the sun sinks into its waves
 * as you scroll past: the afternoon §10 started at the top of the page ends
 * here. Under reduced motion it is simply drawn.
 *
 * All copy verbatim §11.
 */
const sun = LOGOMARK.paths.filter((p) => p.role !== 'wave');
const waves = LOGOMARK.paths.filter((p) => p.role === 'wave');
---

<section class="closer band-dark grain" data-progress aria-labelledby="closer-title">
  <div class="shell closer__inner">
    <svg
      class="closer__mark"
      viewBox={`0 0 ${LOGOMARK.box[0]} ${LOGOMARK.box[1]}`}
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <clipPath id="closer-sea">
          <rect x="-10" y="-10" width="90" height="53" />
        </clipPath>
      </defs>
      <g class="closer__sun" clip-path="url(#closer-sea)">
        <g class="closer__sun-inner">
          {sun.map((p, i) => (
            <path d={p.d} pathLength="1" style={`--d:${i}`} />
          ))}
        </g>
      </g>
      {waves.map((p, i) => (
        <path class="closer__wave" d={p.d} pathLength="1" style={`--d:${i + sun.length}`} />
      ))}
    </svg>

    <p class="t-eyebrow">No membership needed</p>
    <!-- §11 verbatim -->
    <h2 class="t-quote closer__quote" id="closer-title">Two hours that are only yours</h2>
    <!-- §11 verbatim -->
    <BookCta variant="on-dark" size="lg" magnetic />
  </div>
</section>

<style>
  .closer {
    padding-block: var(--section-y);
    overflow: hidden;
  }

  .closer__inner {
    display: grid;
    justify-items: start;
    gap: var(--space-lg);
  }

  .closer__quote {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(3rem, 9vw, 7.5rem);
    line-height: 0.95;
    rotate: -2deg;
  }

  .closer__mark {
    width: min(70vw, 26rem);
    overflow: visible;
    fill: none;
    stroke: var(--royal-gold);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Drawn on as the band arrives: --p runs 0→1 across the band's whole trip
     through the viewport, so the first third draws it and the last third
     sets the sun. */
  @media (prefers-reduced-motion: no-preference) {
    .closer__mark path {
      stroke-dasharray: 1;
      stroke-dashoffset: clamp(0, calc(1 - (var(--p, 0) * 3.2 - var(--d) * 0.06)), 1);
    }

    .closer__sun-inner {
      translate: 0 calc(max(0, var(--p, 0) - 0.55) * 46px);
    }
  }

  @media (min-width: 900px) {
    .closer__inner {
      grid-template-columns: 1fr auto;
      align-items: end;
      column-gap: var(--space-2xl);
    }
    .closer__mark {
      grid-column: 2;
      grid-row: 1 / span 3;
      align-self: center;
      width: min(36vw, 30rem);
    }
  }
</style>
