---
import BookCta from './BookCta.astro';
import Icon from './Icon.astro';
import { SITE } from '../config/site';

/**
 * Hero — the sun wall (§13 amendment, 2026-10-22).
 *
 * A plaster wall with a palm-frond shadow moving across it, and the logomark
 * standing in front of it as monoline glass. The pointer moves the sun; scroll
 * sets it — the glass sun sinks below its own waves as you leave the hero.
 * Tap the mark and the rays spin.
 *
 * The cover line carries the brand's one tension (§1) in a single breath:
 * tracked caps, then the friend's handwriting, then caps again. Unlike the old
 * video hero, this is real DOM type, so it reflows to a phone, reads to a
 * screen reader, and is the LCP — the canvas loads after it.
 *
 * Without WebGL, or before it arrives, the hero is a CSS wall with the flat
 * monoline mark. Under reduced motion the wall is drawn once and holds still.
 *
 * The intro is CSS keyframes, not the scroll-reveal script, and the words are
 * split here rather than at runtime: the cover line is the LCP, so it must
 * never wait on JavaScript to become visible.
 */
---

<section class="hero" data-hero data-sunwall-host data-progress="leave" aria-labelledby="hero-title">
  <canvas
    class="hero__canvas"
    data-sunwall
    data-mark="logomark"
    data-shadow="0.9"
    data-sunset
    data-intro
    aria-hidden="true"
  ></canvas>

  <div class="hero__inner shell">
    <div class="hero__copy">
      <p class="t-eyebrow hero__eyebrow intro" style="--d: 0ms">
        <span>Day spa</span>
        <span class="hero__dot" aria-hidden="true"></span>
        <span>{SITE.neighbourhood}, Utah</span>
      </p>

      <h1 class="hero__title" id="hero-title">
        <span class="visually-hidden">Sunnyside Spa — </span>
        <span class="t-hero hero__line"><span class="split-word"><span style="--d: 120ms">Sunshine</span></span></span>
        <span class="hero__hand">for your</span>
        <span class="t-hero hero__line hero__line--soul"><span class="split-word"><span style="--d: 380ms">soul</span></span></span>
      </h1>

      <p class="t-body hero__lede intro" style="--d: 620ms">
        One room in the sun, booked one person at a time. Massage, skincare and
        quiet afternoons in {SITE.neighbourhood}.
      </p>

      <div class="hero__actions intro" style="--d: 760ms">
        <BookCta size="lg" magnetic />
        <a class="btn btn--secondary btn--lg hero__secondary" href="/treatments/" data-magnetic>See treatments</a>
      </div>
    </div>

    <div class="hero__slot" data-mark-slot>
      {/* Shown until the glass mark is drawn, and kept if it never is. */}
      <Icon name="logomark" size={680} class="hero__flatmark" />
      <span class="visually-hidden">Tap the sun to spin its rays.</span>
    </div>
  </div>

  <div class="hero__meta shell" aria-hidden="true">
    <span class="t-eyebrow">Appointments only</span>
    <span class="hero__scroll t-eyebrow"><span class="hero__scroll-line"></span>Scroll</span>
    <span class="t-eyebrow hero__meta-end">Sunshine for your soul</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: max(100svh, 38rem);
    display: grid;
    grid-template-rows: 1fr auto;
    overflow: hidden;
    /* The CSS wall — what you see before the canvas lands or without WebGL.
       Same chiffon-toward-gold ground the shader paints. */
    background:
      radial-gradient(90% 70% at 88% 6%, var(--shell), transparent 60%),
      linear-gradient(160deg, color-mix(in srgb, var(--lemon-chiffon) 78%, var(--royal-gold)), var(--lemon-chiffon));
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  .hero__canvas:global(.is-ready) { opacity: 1; }

  @media (prefers-reduced-motion: no-preference) {
    .hero__canvas { transition: opacity 900ms var(--ease-reveal); }
  }

  .hero__inner {
    position: relative;
    display: grid;
    align-items: center;
    padding-block: calc(var(--nav-h) + var(--space-2xl)) var(--space-lg);
    gap: var(--space-lg);
  }

  .hero__copy {
    position: relative;
    z-index: 2;
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    --eyebrow-color: var(--ink);
  }

  .hero__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--rose-deep);
  }

  .hero__title {
    display: grid;
    margin: 0;
    color: var(--ink);
    font-weight: 300;
  }

  .hero__line { display: block; }

  @media (prefers-reduced-motion: no-preference) {
    .hero__line .split-word > span {
      animation: word-rise var(--dur-glide) var(--d, 0ms) var(--ease-glide) both;
    }
    .intro { animation: intro-rise 900ms var(--d, 0ms) var(--ease-glide) both; }
  }

  @keyframes word-rise  { from { translate: 0 105%; } }
  @keyframes intro-rise { from { opacity: 0; translate: 0 18px; } }
  .hero__line--soul { padding-inline-start: 0.9em; }

  /* The friend, between the caps. Rose-deep because it is large display
     type over a light wall — §3's rule for rose-coloured text. */
  .hero__hand {
    display: block;
    margin-block: -0.18em -0.12em;
    padding-inline-start: 0.4em;
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: calc(var(--fs-hero) * 0.62);
    line-height: 1;
    color: var(--rose-deep);
    rotate: -4deg;
    transform-origin: left center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__hand { animation: hand-in 1400ms 520ms var(--ease-glide) both; }
  }

  @keyframes hand-in {
    from { opacity: 0; clip-path: inset(0 100% 0 0); }
    to   { opacity: 1; clip-path: inset(0 -10% 0 0); }
  }

  .hero__lede { max-width: 34ch; color: var(--ink); }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* On the wall the secondary needs a little body to read as a button. */
  .hero__secondary {
    background-color: rgb(252 248 239 / 0.45);
    -webkit-backdrop-filter: blur(8px);
            backdrop-filter: blur(8px);
  }

  .hero__slot {
    position: relative;
    z-index: 1;
    aspect-ratio: 68 / 56;
    width: min(100%, 44rem);
    justify-self: center;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .hero__slot :global(.hero__flatmark) {
    width: 100%;
    height: 100%;
    color: var(--rose-deep);
    transition: opacity 600ms var(--ease-reveal);
  }

  .hero__canvas:global(.is-ready) ~ .hero__inner .hero__slot :global(.hero__flatmark) { opacity: 0; }

  .hero__meta {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-md) var(--space-lg);
    --eyebrow-color: var(--ink);
  }

  .hero__scroll { display: inline-flex; align-items: center; gap: var(--space-sm); }

  .hero__scroll-line {
    position: relative;
    width: 1px;
    height: 34px;
    overflow: hidden;
    background: color-mix(in srgb, var(--ink) 20%, transparent);
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 40%;
    background: var(--ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__scroll-line::after { animation: scroll-cue 2.4s var(--ease-glide) infinite; }

    /* Leaving the hero: copy drifts up and fades a little ahead of the page. */
    .hero__copy,
    .hero__meta {
      translate: 0 calc(var(--p, 0) * -14vh);
      opacity: calc(1 - var(--p, 0) * 1.3);
    }
  }

  @keyframes scroll-cue {
    0%   { translate: 0 -100%; }
    100% { translate: 0 260%; }
  }

  /* ── Phone: mark on top, words below, everything inside one screen ────── */
  @media (max-width: 899px) {
    .hero__inner {
      align-content: end;
      padding-block-start: calc(var(--nav-h) + var(--space-lg));
    }
    .hero__slot {
      order: -1;
      width: min(78vw, 26rem);
      justify-self: end;
      margin-inline-end: -4vw;
    }
    .hero__meta-end { display: none; }
  }

  /* On phones the dock floats over the bottom of the hero and already says
     "Appointments only", so the meta row steps aside and the copy clears it. */
  @media (max-width: 639px) {
    .hero__meta { display: none; }
    .hero__inner { padding-block-end: calc(5.5rem + env(safe-area-inset-bottom)); }
  }

  @media (max-width: 479px) {
    .hero__actions { display: grid; width: 100%; }
    .hero__lede { font-size: 1rem; }
  }

  /* ── Desktop: words left, glass sun right ─────────────────────────────── */
  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--space-xl);
    }
    .hero__slot { width: 100%; margin-inline-end: -3vw; }
  }

  /* Wide but short screens: keep the cover line inside the fold. */
  @media (min-width: 900px) and (max-height: 760px) {
    .hero { --fs-hero: clamp(2.75rem, 7vw, 6rem); }
  }
</style>
