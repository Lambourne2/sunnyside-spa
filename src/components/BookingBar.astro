---
import BookCta from './BookCta.astro';
import Icon from './Icon.astro';

/**
 * §8 — "Mobile keeps a persistent bottom booking bar." Now a floating glass
 * dock (§13 amendment) rather than a full-width strip: it sits above the iOS
 * home indicator, lets the page show around it, and keeps the one action a
 * thumb's reach away on every screen.
 *
 * Hidden at 640px and up, where the nav's Book button is always in reach.
 */
---

<div class="dock">
  <div class="dock__bar glass" data-liquid="20">
    <span class="dock__note">
      <Icon name="logomark" size={30} />
      <span class="t-meta">Appointments only</span>
    </span>
    <BookCta />
  </div>
</div>

<style>
  .dock {
    position: fixed;
    inset-inline: 0;
    bottom: max(10px, env(safe-area-inset-bottom));
    z-index: 60;
    display: flex;
    justify-content: center;
    padding-inline: 10px;
    pointer-events: none;
  }

  .dock__bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    width: min(100%, 26rem);
    padding: 6px 6px 6px 14px;
    border-radius: var(--r-tag);
    background-color: var(--glass-tint-hi);
  }

  .dock__note {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-width: 0;
    color: var(--ink-soft);
    --meta-color: var(--ink-soft);
  }

  .dock__note .t-meta { font-size: 0.75rem; line-height: 1.25; }

  @media (max-width: 359px) {
    .dock__note :global(.icon) { display: none; }
  }

  .dock__note :global(.icon) { color: var(--dusty-rose); }

  .dock__bar :global(.btn) { padding: 14px 20px; }

  @media (min-width: 640px) {
    .dock { display: none; }
  }

</style>
