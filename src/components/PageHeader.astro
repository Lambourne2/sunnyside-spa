---
import Icon, { type IconName } from './Icon.astro';

/**
 * Interior page header (§7) — the same sun wall as the homepage, so every page
 * reads as lit by the same sun. §7 asked for a leaf-shadow PNG drifting here;
 * that asset never arrived, and the shader draws the shadow instead.
 *
 * Each page stands its own glass mark on the wall: the service icon on a
 * treatment page, the logomark elsewhere. The title is split into words here,
 * on the server, and animated in CSS, because it is the page's LCP and must
 * never wait on script.
 */
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
  mark?: IconName;
}
const { eyebrow, title, lede, mark = 'logomark' } = Astro.props;
const words = title.split(' ');
---

<header class="phead" data-hero data-sunwall-host data-progress="leave">
  <canvas class="phead__canvas" data-sunwall data-mark={mark} data-shadow="0.8" data-intro aria-hidden="true"></canvas>
  <div class="shell phead__inner">
    <div class="phead__copy">
      <p class="t-eyebrow phead__eyebrow phead__in" style="--d: 0ms">{eyebrow}</p>
      <h1 class="t-display phead__title">
        {words.map((w, i) => (
          <>
            <span class="split-word"><span style={`--d:${120 + i * 70}ms`}>{w}</span></span>{i < words.length - 1 && ' '}
          </>
        ))}
      </h1>
      {lede && <p class="t-body phead__lede phead__in" style="--d: 420ms">{lede}</p>}
    </div>
    <div class="phead__slot" data-mark-slot aria-hidden="true">
      <Icon name={mark} size={320} class="phead__flat" />
    </div>
  </div>
</header>

<style>
  .phead {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(90% 70% at 88% 6%, var(--shell), transparent 60%),
      linear-gradient(160deg, color-mix(in srgb, var(--lemon-chiffon) 78%, var(--royal-gold)), var(--lemon-chiffon));
  }

  .phead__canvas {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  .phead__canvas:global(.is-ready) { opacity: 1; }

  @media (prefers-reduced-motion: no-preference) {
    .phead__canvas { transition: opacity 900ms var(--ease-reveal); }
    .phead__title .split-word > span { animation: ph-word var(--dur-glide) var(--d, 0ms) var(--ease-glide) both; }
    .phead__in { animation: ph-in 900ms var(--d, 0ms) var(--ease-glide) both; }
    .phead__copy { translate: 0 calc(var(--p, 0) * -8vh); }
  }

  @keyframes ph-word { from { translate: 0 105%; } }
  @keyframes ph-in   { from { opacity: 0; translate: 0 16px; } }

  .phead__inner {
    display: grid;
    align-items: end;
    gap: var(--space-lg);
    min-height: min(80svh, 44rem);
    padding-block: calc(var(--nav-h) + var(--space-2xl)) var(--space-2xl);
  }

  .phead__copy { position: relative; z-index: 1; display: grid; gap: var(--space-md); }

  .phead__eyebrow { --eyebrow-color: var(--ink); }

  .phead__title { max-width: 14ch; margin: 0; }

  .phead__lede { max-width: 46ch; color: var(--ink); }

  .phead__slot {
    aspect-ratio: 1;
    width: min(44vw, 13rem);
    justify-self: end;
    order: -1;
  }

  .phead__slot :global(.phead__flat) {
    width: 100%;
    height: 100%;
    color: var(--rose-deep);
    transition: opacity 600ms var(--ease-reveal);
  }

  .phead__canvas:global(.is-ready) ~ .phead__inner .phead__slot :global(.phead__flat) { opacity: 0; }

  @media (min-width: 900px) {
    .phead__inner {
      grid-template-columns: 1.3fr 0.7fr;
      align-items: center;
    }
    .phead__slot { order: 0; width: min(100%, 22rem); justify-self: center; }
  }
</style>
